+/// ATP: a resource inserted by the test plugin.
+#[derive(bevy_ecs::prelude::Resource)]
+struct AtpResource(&'static str);
+
+fn atp_name(names: &Query<&PlayerName>, entity: bevy_ecs::prelude::Entity) -> String {
+    names.get(entity).map(|n| n.0.clone()).unwrap_or_else(|_| "?".to_string())
+}
+
+fn atp_startup(resource: bevy_ecs::prelude::Res<AtpResource>) {
+    tracing::info!(resource = resource.0, "ATP event startup");
+}
+
+fn atp_join(
+    e: On<voidmc::events::PlayerJoinEvent>,
+    resource: bevy_ecs::prelude::Res<AtpResource>,
+    names: Query<&PlayerName>,
+) {
+    tracing::info!(player = %atp_name(&names, e.entity), client_id = e.client_id, resource = resource.0, "ATP event join");
+}
+
+fn atp_ready(e: On<PlayerReadyEvent>, names: Query<&PlayerName>) {
+    tracing::info!(player = %atp_name(&names, e.entity), client_id = e.client_id, "ATP event ready");
+}
+
+fn atp_quit(e: On<voidmc::events::PlayerQuitEvent>, names: Query<&PlayerName>) {
+    tracing::info!(player = %atp_name(&names, e.entity), client_id = e.client_id, "ATP event quit");
+}
+
+fn atp_chat(e: On<voidmc::events::ChatMessageEvent>, names: Query<&PlayerName>) {
+    tracing::info!(player = %atp_name(&names, e.entity), text = %e.message, "ATP event chat");
+}
+
+fn atp_move(e: On<voidmc::events::PlayerMoveEvent>, names: Query<&PlayerName>) {
+    tracing::info!(
+        player = %atp_name(&names, e.entity),
+        old = %format!("{:.2},{:.2},{:.2}", e.old_x, e.old_y, e.old_z),
+        new = %format!("{:.2},{:.2},{:.2}", e.new_x, e.new_y, e.new_z),
+        "ATP event move"
+    );
+}
+
+fn atp_rotate(e: On<voidmc::events::PlayerRotateEvent>, names: Query<&PlayerName>) {
+    tracing::info!(player = %atp_name(&names, e.entity), yaw = e.yaw, pitch = e.pitch, "ATP event rotate");
+}
+
+fn atp_break(e: On<voidmc::events::BlockBreakEvent>, names: Query<&PlayerName>) {
+    let p = &e.position;
+    tracing::info!(player = %atp_name(&names, e.entity), position = %format!("{},{},{}", p.x, p.y, p.z), state = e.broken_state, "ATP event break");
+}
+
+fn atp_place(e: On<voidmc::events::BlockPlaceEvent>, names: Query<&PlayerName>) {
+    let p = &e.position;
+    tracing::info!(player = %atp_name(&names, e.entity), position = %format!("{},{},{}", p.x, p.y, p.z), state = e.placed_state, "ATP event place");
+}
+
+fn atp_use(e: On<voidmc::events::PlayerUseItemEvent>, names: Query<&PlayerName>) {
+    tracing::info!(player = %atp_name(&names, e.entity), hand = ?e.hand, sequence = e.sequence, "ATP event use-item");
+}
