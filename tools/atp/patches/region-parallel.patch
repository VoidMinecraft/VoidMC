+/// TEMPORARY ATP-028 instrumentation (not part of the product): records every call of
+/// the per-region physics closure with its thread and enter/exit times.
+#[allow(dead_code, missing_docs)]
+pub mod atp_regions {
+    use crate::world::RegionPos;
+    use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering::SeqCst};
+    use std::sync::{Mutex, OnceLock};
+    use std::time::Instant;
+
+    pub static TICK: AtomicU64 = AtomicU64::new(0);
+    pub static PEAK: AtomicUsize = AtomicUsize::new(0);
+    pub static LOG: Mutex<Vec<String>> = Mutex::new(Vec::new());
+    static ACTIVE: AtomicUsize = AtomicUsize::new(0);
+    static START: OnceLock<Instant> = OnceLock::new();
+
+    pub fn enter() -> u128 {
+        let active = ACTIVE.fetch_add(1, SeqCst) + 1;
+        PEAK.fetch_max(active, SeqCst);
+        START.get_or_init(Instant::now).elapsed().as_nanos()
+    }
+
+    pub fn exit(region: RegionPos, entities: usize, enter_ns: u128) {
+        let exit_ns = START.get_or_init(Instant::now).elapsed().as_nanos();
+        ACTIVE.fetch_sub(1, SeqCst);
+        let tick = TICK.load(SeqCst);
+        if tick > 0 {
+            LOG.lock().unwrap().push(format!(
+                "tick={tick} region=({},{}) entities={entities} thread={:?} enter_ns={enter_ns} exit_ns={exit_ns}",
+                region.x,
+                region.z,
+                std::thread::current().id()
+            ));
+        }
+    }
+}
