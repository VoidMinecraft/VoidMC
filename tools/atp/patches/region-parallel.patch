+const ATP_PIGS_PER_REGION: u32 = 60;
+const ATP_TICKS: u64 = 120;
+
+#[derive(bevy_ecs::prelude::Component)]
+struct AtpPig(u32);
+
+#[derive(bevy_ecs::prelude::Resource, Default)]
+struct AtpTrace {
+    tick_start: Option<std::time::Instant>,
+    rows: Vec<String>,
+    ticks: Vec<String>,
+}
+
+/// Spawns 60 pigs in region (0,0) and 60 in region (-1,-1) from a fixed seed, once the
+/// 81 spawn chunks exist. Every second pig walks; all have gravity and block collision.
+fn atp_spawn_pigs(
+    mut commands: bevy_ecs::prelude::Commands,
+    chunks: Query<&voidmc::ChunkPosition>,
+    mut done: bevy_ecs::prelude::Local<bool>,
+) {
+    if *done || chunks.iter().count() < 81 {
+        return;
+    }
+    let mut seed: u64 = 0x2545_F491_4F6C_DD1D;
+    let mut next = move || {
+        seed = seed.wrapping_mul(6_364_136_223_846_793_005).wrapping_add(1_442_695_040_888_963_407);
+        ((seed >> 33) as f64) / ((1u64 << 31) as f64)
+    };
+    for region in 0..2u32 {
+        let sign = if region == 0 { 1.0 } else { -1.0 };
+        for i in 0..ATP_PIGS_PER_REGION {
+            let x = sign * (8.0 + next() * 52.0);
+            let z = sign * (8.0 + next() * 52.0);
+            let y = 70.0 + next() * 50.0;
+            let (vx, vz) = if i % 2 == 0 { ((next() - 0.5) * 0.3, (next() - 0.5) * 0.3) } else { (0.0, 0.0) };
+            let pig = voidmc::entity::EntityBuilder::new(voidmc::entity::EntityKind::Pig)
+                .at(x, y, z)
+                .velocity(voidmc::components::Velocity { x: vx, y: 0.0, z: vz })
+                .gravity(true)
+                .block_collision(true)
+                .wander(false)
+                .settle_ticks(0);
+            commands.spawn((pig.bundle(), AtpPig(region * ATP_PIGS_PER_REGION + i)));
+        }
+    }
+    *done = true;
+    voidmc::systems::physics::atp_regions::TICK.store(1, std::sync::atomic::Ordering::SeqCst);
+    tracing::info!("ATP spawned {} pigs", 2 * ATP_PIGS_PER_REGION);
+}
+
+fn atp_tick_start(mut trace: bevy_ecs::prelude::ResMut<AtpTrace>) {
+    trace.tick_start = Some(std::time::Instant::now());
+}
+
+/// Records every pig's state per tick and writes ATP_TRACE_OUT.{trace,ticks,invocations}.
+fn atp_capture(world: &mut bevy_ecs::prelude::World) {
+    use std::sync::atomic::Ordering::SeqCst;
+    use voidmc::systems::physics::atp_regions as regions;
+    let tick = regions::TICK.load(SeqCst);
+    if tick == 0 || tick > ATP_TICKS {
+        return;
+    }
+    let mut rows = Vec::new();
+    let mut pigs = world.query::<(
+        &AtpPig,
+        &voidmc::components::Position,
+        &voidmc::components::Velocity,
+        &voidmc::components::VerticalVelocity,
+        &voidmc::components::Grounded,
+    )>();
+    for (pig, p, v, vv, g) in pigs.iter(world) {
+        rows.push((pig.0, format!(
+            "tick={tick} id={} pos=({:?},{:?},{:?}) vel=({:?},{:?},{:?}) vvel={:?} grounded={}",
+            pig.0, p.x, p.y, p.z, v.x, v.y, v.z, vv.0, g.0
+        )));
+    }
+    rows.sort();
+    let mut trace = world.resource_mut::<AtpTrace>();
+    let duration = trace.tick_start.map(|t| t.elapsed().as_micros()).unwrap_or(0);
+    trace.rows.extend(rows.into_iter().map(|(_, row)| row));
+    trace.ticks.push(format!("tick={tick} duration_us={duration}"));
+    regions::TICK.store(tick + 1, SeqCst);
+    if tick == ATP_TICKS {
+        let out = std::env::var("ATP_TRACE_OUT").unwrap_or_else(|_| "atp-028".to_string());
+        let trace = world.resource::<AtpTrace>();
+        let written = std::fs::write(format!("{out}.trace"), trace.rows.join("\n") + "\n")
+            .and_then(|_| std::fs::write(format!("{out}.ticks"), trace.ticks.join("\n") + "\n"))
+            .and_then(|_| std::fs::write(format!("{out}.invocations"), regions::LOG.lock().unwrap().join("\n") + "\n"));
+        match written {
+            Ok(()) => tracing::info!(out = %out, peak = regions::PEAK.load(SeqCst), "ATP trace complete, {} ticks", ATP_TICKS),
+            Err(error) => tracing::warn!(out = %out, %error, "ATP trace could not be written"),
+        }
+    }
+}
