+/// ATP: prints the server-side inventory of every player whose inventory changed.
+fn atp_inventory_trace(
+    players: Query<(&PlayerName, &Inventory), bevy_ecs::prelude::Changed<Inventory>>,
+) {
+    for (name, inventory) in &players {
+        let slots: Vec<_> = (0..Inventory::SIZE)
+            .filter_map(|index| {
+                let stack = inventory.get(index);
+                (!stack.is_empty()).then(|| (index, stack.item.name().unwrap_or("?"), stack.count))
+            })
+            .collect();
+        let cursor = inventory.cursor();
+        tracing::info!(
+            player = %name.0,
+            ?slots,
+            cursor_item = ?cursor.item.name(),
+            cursor_count = cursor.count,
+            "ATP inventory"
+        );
+    }
+}
