+/// ATP: flat terrain with its surface at Y=80 and stripes along X: four columns of
+/// gold blocks, then four of grass, repeating (gold where world X mod 8 is 0-3).
+struct AtpStripes;
+
+impl voidmc::WorldGenerator for AtpStripes {
+    fn generate_chunk(&self, pos: &voidmc::ChunkPos) -> voidmc_protocol::clientbound::chunk::Chunk {
+        use voidmc_protocol::clientbound::chunk::{ChunkBuilder, blocks};
+        let mut builder = ChunkBuilder::new(pos.x, pos.z).with_heightmap(|_, _| 80, blocks::STONE);
+        for x in 0..16u8 {
+            for z in 0..16u8 {
+                let world_x = pos.x * 16 + i32::from(x);
+                let top = if world_x.rem_euclid(8) < 4 {
+                    voidmc_data::v26_1_2::blocks::GOLD_BLOCK
+                } else {
+                    blocks::GRASS_BLOCK
+                };
+                builder.set_block(x, 79, z, top);
+            }
+        }
+        tracing::info!(chunk = %format!("{},{}", pos.x, pos.z), "ATP generator chunk");
+        builder.build()
+    }
+
+    fn surface_height_at(&self, _x: i32, _z: i32) -> i32 {
+        80
+    }
+}
