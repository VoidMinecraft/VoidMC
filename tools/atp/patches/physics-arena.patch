+/// ATP: a stone floor at Y=110 from (17,110,17) to (30,110,30), glass walls three
+/// blocks high on its edges (X=17, X=30, Z=17, Z=30), and a one-block stone rise along
+/// Z=25 from X=18 to X=29. The air above the floor is cleared up to Y=115.
+fn atp_arena(
+    mut chunks: Query<(&voidmc::ChunkPosition, &mut voidmc::ChunkData)>,
+    mut done: bevy_ecs::prelude::Local<bool>,
+) {
+    if *done {
+        return;
+    }
+    for (position, mut chunk) in &mut chunks {
+        if (position.0.x, position.0.z) != (1, 1) {
+            continue;
+        }
+        let stone = voidmc_data::v26_1_2::blocks::STONE;
+        let glass = voidmc_data::v26_1_2::blocks::GLASS;
+        for x in 1..15 {
+            for z in 1..15 {
+                chunk.set_block(x, 110, z, stone);
+                for y in 111..116 {
+                    chunk.set_block(x, y, z, 0);
+                }
+            }
+        }
+        for i in 1..15 {
+            for y in 111..114 {
+                chunk.set_block(i, y, 1, glass);
+                chunk.set_block(i, y, 14, glass);
+                chunk.set_block(1, y, i, glass);
+                chunk.set_block(14, y, i, glass);
+            }
+        }
+        for x in 2..14 {
+            chunk.set_block(x, 111, 9, stone);
+        }
+        *done = true;
+        tracing::info!("ATP arena ready");
+    }
+}
